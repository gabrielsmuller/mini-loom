# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored so your
# email (and any other real values) never get committed.
alert_email = "you@example.com"

# Google OAuth client (for Cognito's Google sign-in). Create these in Google
# Cloud (see below), then paste them here. terraform.tfvars is gitignored.
google_client_id     = "xxxxxxxx.apps.googleusercontent.com"
google_client_secret = "xxxxxxxxxxxxxxxxxxxx"

# Optional overrides:
# aws_region       = "us-east-1"
# budget_limit_usd = "5"
