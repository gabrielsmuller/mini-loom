# Copy to .env for local development.

# Base URL of the FastAPI backend.
VITE_API_URL=http://localhost:8000

# Cognito login (from `terraform output`):
#   VITE_COGNITO_AUTHORITY  = cognito_issuer
#   VITE_COGNITO_CLIENT_ID  = cognito_client_id
#   VITE_COGNITO_DOMAIN     = cognito_domain  (hosted UI base, used for logout)
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=https://mini-loom-xxxxxxxxxxxx.auth.us-east-1.amazoncognito.com
